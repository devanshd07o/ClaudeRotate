{
  "manifest_version": 3,
  "name": "Claude Handover",
  "version": "1.4",
  "description": "One-click session handover for Claude.ai.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://api.groq.com/*",
    "https://api.cerebras.ai/*",
    "https://api.mistral.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  }
}
